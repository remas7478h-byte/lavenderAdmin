<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Candle"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- مكان أو زر اختيار الصورة (موافق للي بالصورة) -->
    <ImageView
        android:id="@+id/imgCandle"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:ic_menu_gallery"
        android:background="#E0E0E0"
        android:scaleType="centerCrop"
        android:layout_marginBottom="16dp"
        android:contentDescription="Pick image" />

    <EditText
        android:id="@+id/etCandleName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Name"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etCandlePrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Price"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etCandleDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Description"
        android:inputType="text"
        android:layout_marginBottom="24dp" />

    <!-- زر الإضافة النهائي -->
    <Button
        android:id="@+id/btnAddCandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ADD" />

</LinearLayout>